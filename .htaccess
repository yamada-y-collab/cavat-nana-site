# ============================================================
# ホームヘルパーNANA 公式サイト（エックスサーバー）
# public_html 直下に設置する。
# ------------------------------------------------------------
# 先頭2行はXserverが自動生成したXアクセラレータ（Nginxキャッシュ）
# 設定。消すと高速化が無効になるため必ず残すこと。
# ============================================================
SetEnvIf Request_URI ".*" Ngx_Cache_NoCacheMode=off
SetEnvIf Request_URI ".*" Ngx_Cache_AllCacheMode

# --- 文字コード ---
AddDefaultCharset UTF-8

# --- 常時SSL（http → https）＋ www なしに統一 ---
RewriteEngine on

# http でのアクセスを https へ（Xserver標準の記述）
RewriteCond %{HTTPS} !on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# www 付きを www なしへ統一
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [R=301,L]

# --- エラーページ ---
ErrorDocument 404 /404.html

# --- ディレクトリ一覧の表示を無効化 ---
Options -Indexes

# --- キャッシュ ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType application/pdf "access plus 7 days"
</IfModule>

# --- セキュリティヘッダー ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- 設定ファイルへの直接アクセスを禁止 ---
<FilesMatch "^\.(htaccess|htpasswd|gitignore|user\.ini)$">
  Require all denied
</FilesMatch>
